# Spotify app (Spotify Developer Dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/spotify/callback
# Obtained once via /api/spotify/login, then pasted here for silent refresh on every sync
SPOTIFY_REFRESH_TOKEN=

# Self-hosted Supabase (service role key — server-side only, never exposed to the client)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# Bearer token required by POST /api/cron/sync
CRON_SECRET=
