# Prefer `bun run setup`; account/key walkthrough: docs/SETUP.md.
# Manual fallback: copy this file to .env.local. Never commit filled env files.
# For Vercel use `bun run setup --target vercel` to keep a separate .env.vercel.

# Spotify app (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/spotify/callback
# Saved automatically by `bun run setup:spotify` (recommended).
# Register http://127.0.0.1:43821/api/spotify/callback for that temporary listener.
# For in-app OAuth, sign in to /login first, then visit /api/spotify/login.
SPOTIFY_REFRESH_TOKEN=

# Local Docker OR your own hosted Supabase project. Server-side only.
# Hosted: secret key (sb_secret_...) or legacy service_role JWT, NOT anon/publishable.
# Vercel must use a hosted URL such as https://your-project-ref.supabase.co.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# Bearer token required by /api/cron/sync and /api/cron/musicbrainz. On Vercel,
# setting this also makes Vercel Cron send it as `Authorization: Bearer <value>`.
CRON_SECRET=

# App access gate (proxy.ts). Single-user password login — no accounts.
# APP_PASSWORD: unique 16+ character password you type on /login (required locally too).
# AUTH_SECRET: random 32+ char string used to sign the session cookie.
#   Generate one with: openssl rand -hex 32
APP_PASSWORD=
AUTH_SECRET=

# MusicBrainz (https://musicbrainz.org/doc/MusicBrainz_API) — enriches saved
# albums with genre/label data now that Spotify's own fields are unreliable.
# Required only for enrichment: a contact identifier in the User-Agent header.
# No MusicBrainz account/API key needed. Remove its Vercel cron if not using it.
MUSICBRAINZ_CONTACT_EMAIL=
# Minimum ms between requests. MusicBrainz enforces 1 req/sec for anonymous
# use with no path to a higher quota — default (1100ms) is a safety margin
# above that; don't lower it below 1000.
MUSICBRAINZ_MIN_REQUEST_INTERVAL_MS=1100
